# Virtualenv. `venv/`, not `.venv/` -- see the Makefile's `venv` target.
venv/
.venv/

# Python build and bytecode
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and lint caches
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.basedpyright/

# Generated by `python -m ml_meta_perf`. The equations, tables and figures are reproducible
# from the shipped corpus in about 25 seconds, so only the narrative chapters and the
# figures the README links are tracked.
results/

# Generated by pdoc from the module docstrings; see .github/workflows/docs.yml.
docs_build/
/docs/

# Working notes, deliberately local. `CLAUDE.md` is agent orientation; findings that belong
# to the study go into assets/docs/ instead.
#
# `todo.md` was the second, untracked research record. It was merged into the tracked
# `TODO.md` on 2026-09-07 and deleted -- there is one handoff now, not two. The rule stays so
# a future session's scratch notes cannot be committed by accident. Note that git is
# case-sensitive here: this ignores `todo.md` and not `TODO.md`.
CLAUDE.md
todo.md
paired.py
paired2.py

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store

# Superseded by `validate.paired_comparison`; kept out of the tree like the other notes.
ISSUES.md
