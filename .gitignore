# Virtualenv. `venv/`, not `.venv/` -- see the Makefile's `venv` target.
venv/
.venv/

# Python build and bytecode
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and lint caches
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.basedpyright/

# Generated by `python -m metafit`. The equations, tables and figures are reproducible
# from `data/meta_dataset.csv` in about 25 seconds, so only the narrative chapters and the
# figures the README links are tracked.
results/

# Generated by `make docs` from the module docstrings.
/docs/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
